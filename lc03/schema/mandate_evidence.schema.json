{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lc03/mandate_evidence.schema.json",
  "title": "MandateEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "principal",
    "issuer",
    "capacity",
    "jurisdiction",
    "case_id",
    "powers",
    "scope",
    "valid_from",
    "valid_until",
    "issued_at",
    "credential_id",
    "audience",
    "request_hash",
    "status",
    "provenance",
    "verification"
  ],
  "properties": {
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "organisation"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "organisation": {"type": "string", "minLength": 1}
      }
    },
    "issuer": {"type": "string", "minLength": 1},
    "capacity": {"type": "string", "minLength": 1},
    "jurisdiction": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "powers": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "issued_at": {"type": "string", "format": "date-time"},
    "credential_id": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "request_hash": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "delegation_chain": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "default": []
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "source"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["active", "revoked", "expired", "unknown"]
        },
        "source": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "source"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_checked_at", "verified_by"],
      "properties": {
        "authority_checked_at": {"type": "string", "format": "date-time"},
        "verified_by": {"type": "string", "minLength": 1}
      }
    }
  }
}
